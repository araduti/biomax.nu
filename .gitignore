# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
# .env.example is intentionally committed

# WordPress migration exports — contain PII, large binary, never commit
biomax.WordPress.*.xml
*.WordPress.*.xml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Lighthouse CI artefacts
.lighthouseci/

# ── Secrets — credential files (NEVER commit) ────────────────────────
# Google Cloud / GCP service-account JSON keys. Pattern matches anything
# named like a key (e.g. biomax-gsc-key.json) regardless of folder.
*-key.json
*-keyfile.json
*service-account*.json
*credentials*.json
*.serviceaccount.json
# Other credential file shapes
*.key
secrets/
.secrets/

# ── Editor / tooling local state ─────────────────────────────────────
# Claude Code's per-machine session + settings (e.g. settings.local.json)
.claude/

# ── User-uploaded runtime assets ─────────────────────────────────────
# Hero photos editors upload from /admin/startsida/hero land here.
# They're production state, not source code — never commit. Production
# environments mount object storage instead. Pre-commit hero photos
# (seeded migration thumbnails) point at Unsplash URLs and aren't on
# disk, so this rule has no false positives today.
/public/uploads/
# Carrier-issued shipping-label PDFs written at booking time by
# lib/postnord/booking.ts. Re-fetchable from PostNord by shipment id —
# never source-controlled, never committed (contains customer
# addresses).
/public/labels/
