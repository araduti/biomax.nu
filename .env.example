# ────────────────────────────────────────────────────────────────────
# biomax.nu — environment variable reference
#
# Copy this file to .env.local and fill in the values for your local
# environment. Anything left empty falls back to STUB MODE for that
# integration — the app boots and feature surfaces remain wired, you
# just don't make real outbound calls until creds are provided.
#
# Generated/maintained by the post-feature audit (see TODO.md §17).
# ────────────────────────────────────────────────────────────────────

# ── Platform / 12-factor runtime (REQUIRED in prod) ─────────────────
# These four + DATABASE_URL + BETTER_AUTH_* are validated at boot
# (lib/env.ts) — a missing one fails the container fast. See
# docs/deployment.md §Runtime env for the authoritative table.
NODE_ENV="development"          # "production" in prod containers
PORT="3000"                     # app listen port (default 3000)
LOG_LEVEL="info"                # optional; info by default
# Client-side canonical URL. Same value as BETTER_AUTH_URL. Falls back
# to NEXT_PUBLIC_SITE_URL if unset (legacy).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database ─────────────────────────────────────────────────────────
# Default points at docker-compose.dev.yml in this repo.
# Prod: the DML-only `*_app` role (used by the running app).
DATABASE_URL="postgresql://biomax:biomax@localhost:5433/biomax_dev"
# Used ONLY by the Prisma CLI in the one-shot migrate container (DDL +
# RLS bypass — the `*_migrate` role). Locally leave empty: migrations
# fall back to DATABASE_URL. See prisma.config.ts.
DATABASE_MIGRATE_URL=""

# ── App ──────────────────────────────────────────────────────────────
# Legacy/server canonical URL. Prefer NEXT_PUBLIC_APP_URL above; this
# is kept as a fallback for existing call sites.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Better Auth ──────────────────────────────────────────────────────
# Generate a session-cookie secret with: openssl rand -hex 32
# (platform uses: openssl rand -base64 32). REQUIRED — no default.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── Admin bootstrap seeder (prisma/seeds/index.ts) ──────────────────
# Runs from the one-shot migrate container. If EITHER is empty the
# seeder is a no-op. CLEAR SEED_ADMIN_PASSWORD after the first deploy.
SEED_ADMIN_EMAIL="admin@biomax.nu"
SEED_ADMIN_PASSWORD=""

# ── Kustom checkout (formerly Klarna — stub mode when empty) ────────
# ADR 0020: Kustom-managed shipping. The Kustom test ground issues its
# OWN api key id + password (distinct from the legacy Klarna Checkout
# v3 username/password). Paste them below. KUSTOM_API_URL is REQUIRED
# when KUSTOM_API_KEY_ID is set — the legacy Klarna host does NOT run
# the Kustom Shipping Assistant (you get a checkout with no PostNord
# options + a "still using Klarna endpoints" portal warning). Use the
# playground host while testing, production host when live. The
# /checkout/v3/orders path is appended in code.
#   playground:  https://api.playground.kustom.co
#   production:   https://api.kustom.co
KUSTOM_API_URL="https://api.playground.kustom.co"
KUSTOM_API_KEY_ID=""
KUSTOM_API_PASSWORD=""
# Kustom validates merchant_urls.push as a PUBLIC HTTPS url — http /
# localhost returns 400 "Bad value: push". For local testing run an
# HTTPS tunnel (e.g. `ngrok http 3000` / `cloudflared`) and set this
# to the tunnel origin. Falls back to BETTER_AUTH_URL when unset.
KUSTOM_MERCHANT_BASE_URL=""
# Legacy Klarna Checkout v3 creds — kept as a fallback so older setups
# keep working. Prefer the KUSTOM_* vars above. When all four are
# empty the system runs in stub mode.
KLARNA_API_URL="https://api.playground.klarna.com"
KLARNA_USERNAME=""
KLARNA_PASSWORD=""
# Shared secret authenticating the server-to-server push receiver
# (/api/webhooks/klarna). Kustom/Klarna Checkout v3 push is unsigned, so
# the secret is appended to the push URL automatically (see
# lib/klarna/cart-to-order.ts). When set, the webhook fails closed on a
# bad/missing token; when empty it falls back to localhost-only (dev).
# Generate with: openssl rand -hex 32. REQUIRED in any live deploy.
KLARNA_WEBHOOK_SECRET=""
# Public payment-widget client id for Klarna On-site Messaging.
NEXT_PUBLIC_KLARNA_CLIENT_ID=""
# Kustom Elements (Express buttons). Both are PUBLIC (client-exposed)
# and come from the Kustom portal → Elements → Installation script.
# Unset → the loader + Express strip don't render (dev/CI clean).
# Playground host: https://js.playground.kustom.co/kustom-elements/v1/pre-load.js
# Also register the host domain in Kustom → Elements → My domains
# (incl. the ngrok tunnel for testing, prod domain for prod).
NEXT_PUBLIC_KUSTOM_ELEMENTS_SRC=""
NEXT_PUBLIC_KUSTOM_ELEMENTS_KEY=""

# ── Brevo (transactional + marketing email — stub mode when empty) ──
BREVO_API_KEY=""
BREVO_FROM_EMAIL="noreply@biomax.nu"
BREVO_FROM_NAME="Biomax"
BREVO_REPLY_TO_EMAIL="kontakt@biomax.nu"
# Shared secret for the /api/webhooks/brevo receiver. Configure Brevo's
# webhook URL as: https://www.biomax.nu/api/webhooks/brevo?token=$BREVO_WEBHOOK_SECRET
# Required in any non-localhost deploy.
BREVO_WEBHOOK_SECRET=""

# ── PostNord (tracking + service-point lookup) ──────────────────────
# Service-point lookup ("kund väljer ombud i kassan") needs only the
# API key. Leave POSTNORD_BASE_URL unset to use the correct default
# endpoint baked into lib/postnord/service-points.ts. Only override it
# with the FULL path — the bare host 404s because the code appends
# just the query string, not the /rest/businesslocation/... path.
POSTNORD_API_KEY=""
# POSTNORD_BASE_URL="https://api2.postnord.com/rest/businesslocation/v5/servicepoints"

# Shipment booking / label PDF ("skapa fraktsedel") additionally needs
# the customer + payer numbers from your PostNord shipping agreement.
# Without all three, booking stays in stub mode (synthetic tracking).
POSTNORD_CUSTOMER_NUMBER=""
POSTNORD_PAYER_NUMBER=""
# Shipment v3 endpoint. Default is production. For the pre-launch dry
# run point this at PostNord's test gateway (agreement-linked test
# creds required — same path, no real postage charged):
#   POSTNORD_SHIPMENT_BASE_URL="https://atapi2.postnord.com/rest/shipment/v3/edi"
# POSTNORD_SHIPMENT_BASE_URL="https://api2.postnord.com/rest/shipment/v3/edi"

# ── Google Search Console (SEO insights) ────────────────────────────
# Path to a service-account JSON key file (granted GSC API access on
# the property below), or paste the JSON inline.
GSC_SERVICE_ACCOUNT_KEY=""
GSC_PROPERTY="sc-domain:biomax.nu"

# ── Cron auth ────────────────────────────────────────────────────────
# Required in any non-localhost deploy. Vercel/EasyCron sends this as
# `Authorization: Bearer ${CRON_SECRET}`. Leave empty in dev — the
# helper allows localhost without a secret.
CRON_SECRET=""

# ── Plausible analytics ─────────────────────────────────────────────
# Client-side tracking script (public, optional):
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_HOST="https://plausible.io"
NEXT_PUBLIC_PLAUSIBLE_SCRIPT="https://plausible.io/js/script.js"
# Server-side Stats API — powers the Översikt "Besök · konv." KPI.
# SECRET, never NEXT_PUBLIC. Without it the KPI renders "—" (stub
# mode). Site id falls back to NEXT_PUBLIC_PLAUSIBLE_DOMAIN; host
# falls back to NEXT_PUBLIC_PLAUSIBLE_HOST (set these only to override,
# e.g. a self-hosted Plausible).
PLAUSIBLE_API_KEY=""
# PLAUSIBLE_SITE_ID=""
# PLAUSIBLE_API_HOST="https://plausible.io"

# ── Sentry (error tracking — stub mode when DSN empty) ──────────────
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"clea
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ── Uptime check origin (for the health endpoint pinger) ────────────
UPTIME_BASE_URL=""
UPTIME_ORIGIN=""

# ── LLM citation testing (optional; lib/llm-citation) ───────────────
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""

# ── Operations ───────────────────────────────────────────────────────
# Path the pg_dump backup script writes to. Defaults to ./backups when empty.
BACKUP_DIR=""
