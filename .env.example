# ────────────────────────────────────────────────────────────────────
# biomax.nu — environment variable reference
#
# Copy this file to .env.local and fill in the values for your local
# environment. Anything left empty falls back to STUB MODE for that
# integration — the app boots and feature surfaces remain wired, you
# just don't make real outbound calls until creds are provided.
#
# Generated/maintained by the post-feature audit (see TODO.md §17).
# ────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────
# Default points at docker-compose.dev.yml in this repo.
DATABASE_URL="postgresql://biomax:biomax@localhost:5433/biomax_dev"

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Better Auth ──────────────────────────────────────────────────────
# Generate a session-cookie secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── Klarna (Phase 3 — stub mode when empty) ─────────────────────────
# Use the playground host until production checkout goes live.
KLARNA_API_URL="https://api.playground.klarna.com"
KLARNA_USERNAME=""
KLARNA_PASSWORD=""
# Public payment-widget client id for Klarna On-site Messaging.
NEXT_PUBLIC_KLARNA_CLIENT_ID=""

# ── Brevo (transactional + marketing email — stub mode when empty) ──
BREVO_API_KEY=""
BREVO_FROM_EMAIL="noreply@biomax.nu"
BREVO_FROM_NAME="Biomax"
BREVO_REPLY_TO_EMAIL="kontakt@biomax.nu"
# Shared secret for the /api/webhooks/brevo receiver. Configure Brevo's
# webhook URL as: https://www.biomax.nu/api/webhooks/brevo?token=$BREVO_WEBHOOK_SECRET
# Required in any non-localhost deploy.
BREVO_WEBHOOK_SECRET=""

# ── PostNord (tracking + service-point lookup) ──────────────────────
POSTNORD_API_KEY=""
POSTNORD_BASE_URL="https://api2.postnord.com"

# ── Google Search Console (SEO insights) ────────────────────────────
# Path to a service-account JSON key file (granted GSC API access on
# the property below), or paste the JSON inline.
GSC_SERVICE_ACCOUNT_KEY=""
GSC_PROPERTY="sc-domain:biomax.nu"

# ── Cron auth ────────────────────────────────────────────────────────
# Required in any non-localhost deploy. Vercel/EasyCron sends this as
# `Authorization: Bearer ${CRON_SECRET}`. Leave empty in dev — the
# helper allows localhost without a secret.
CRON_SECRET=""

# ── Plausible analytics (optional, client-side) ─────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_HOST="https://plausible.io"
NEXT_PUBLIC_PLAUSIBLE_SCRIPT="https://plausible.io/js/script.js"

# ── Sentry (error tracking — stub mode when DSN empty) ──────────────
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ── Uptime check origin (for the health endpoint pinger) ────────────
UPTIME_BASE_URL=""
UPTIME_ORIGIN=""

# ── LLM citation testing (optional; lib/llm-citation) ───────────────
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""

# ── Operations ───────────────────────────────────────────────────────
# Path the pg_dump backup script writes to. Defaults to ./backups when empty.
BACKUP_DIR=""
